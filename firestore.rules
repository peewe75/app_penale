rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // MVP in modalita' test: l'app usa Firestore dal client e non ha ancora login.
      // Limitiamo comunque temporalmente l'accesso pubblico per evitare di lasciarlo aperto indefinitamente.
      allow read, write: if request.time < timestamp.date(2026, 5, 13);
    }
  }
}
